# HTTP RPC used for quotes, simulations, and receipts.
# Public Base RPC works for read-only testing; use Alchemy for production.
RYO_HTTP_RPC=https://mainnet.base.org

# Alchemy Base WebSocket endpoint, required by `watch`.
# RYO_WS_RPC=wss://base-mainnet.g.alchemy.com/v2/REPLACE_ME

# Deployment manifest written after deploying RyoCore.
RYO_MANIFEST=deployments/8453.json

# dry-run | paper | live
RYO_MODE=dry-run

# logs | pending-logs | flashblocks | both | once
RYO_SOURCE=pending-logs

# Profit and gas gates.
RYO_MIN_NET_PROFIT_USD=0.25
RYO_MAX_GAS_PRICE_GWEI=0.05

# Execution safety.
RYO_SLIPPAGE_BPS=20
RYO_PROFIT_BUFFER_BPS=50

# Scanner sizing.
RYO_GRID_POINTS=5
RYO_MAX_CANDIDATES=16
RYO_MAX_HOPS=2
RYO_ASSETS=USDC,WETH
RYO_FALLBACK_GAS=450000

# Rust logs: trace, debug, info, warn, error
RUST_LOG=info
