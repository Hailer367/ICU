# Copy to `.env` and fill in your Supabase project credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Deployed icaremc-admin URL for chat + appointment push notifications.
PUSH_API_BASE_URL=https://your-deployed-admin.example.com

# SMS OTP gateway — Betegna AI (defaults to PUSH_API_BASE_URL when empty).
# Endpoints: POST /sms/send-otp, POST /sms/verify-otp
SMS_API_BASE_URL=https://betegna-ai.vercel.app
# Optional bearer token if the SMS API requires auth.
# SMS_API_KEY=

# App Store numeric ID for update prompts on iOS (from App Store Connect).
# IOS_APP_STORE_ID=

# Google Play listing for Android update prompts (optional — defaults to package id).
# ANDROID_PACKAGE_NAME=com.icaremc.app
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.icaremc.app

# QA only — show update modal without calling store APIs.
# MOCK_UPDATE_PROMPT=true
